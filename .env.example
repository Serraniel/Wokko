# For docker-compose.dev.yml, which builds from source. All of these are optional, and Wokko needs
# no secrets and no database password. Copy this file to .env to change a value.

# The address people use to reach Wokko. Needed for share links, secure cookies, passkeys
# and Claude's hosted connectors.
#PUBLIC_URL=https://wokko.example.com

#WOKKO_PORT=8080
#WOKKO_VERSION=0.4.0 # x-release-please-version
#BACKUP_INTERVAL_HOURS=24
#BACKUP_RETENTION_DAYS=30
#TRASH_RETENTION_DAYS=30
# Optional mail for invites and password links. Also needs PUBLIC_URL. See "Mail" in the README.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_TLS=starttls
#SMTP_USERNAME=wokko@example.com
#SMTP_PASSWORD=your-app-password
#SMTP_FROM=Wokko <wokko@example.com>
