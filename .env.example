# For docker-compose.yml, which builds from source. All of these are optional, and Wokko needs
# no secrets and no database password. Copy this file to .env to change a value.

# The address people use to reach Wokko. Needed for share links, secure cookies, passkeys
# and Claude's hosted connectors.
#PUBLIC_URL=https://wokko.example.com

#WOKKO_PORT=8080
#WOKKO_VERSION=0.1.0 # x-release-please-version
#BACKUP_INTERVAL_HOURS=24
#BACKUP_RETENTION_DAYS=30
#TRASH_RETENTION_DAYS=30
